# 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 GitHub에 올라가지 않는다.
# 키 값은 PM(김정민)이 개인 메시지로 준다. 단톡방·GitHub·이슈에 붙여 넣지 말 것.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENFIGI_API_KEY=
SEC_CONTACT_EMAIL=
MODEL_KEEP=gpt-5-mini
MODEL_TERMINATE=gemini-2.5-flash
MODEL_JUDGE=claude-sonnet-5-5
MODEL_ANALYST=gpt-5-mini
LLM_MOCK=1
